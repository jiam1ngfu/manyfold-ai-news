# Local development overrides. Copy to .dev.vars (git-ignored) and uncomment what you need.
#
# Everything here is OPTIONAL — the app deploys and runs with none of it set,
# which is why the Deploy to Cloudflare button asks you for nothing.

# Relaxes the https-only / no-private-IP checks so you can point at a local agent.
# ENVIRONMENT=development

# Manyfold API base. Defaults to the value in wrangler.jsonc; use staging for local dev.
# MANYFOLD_API_BASE_URL=https://api-staging.manyfold.ai

# When set, every API route except /api/health and /api/state requires an
# `x-admin-password` header. Recommended once your Worker is public:
#   npx wrangler secret put ADMIN_PASSWORD
# ADMIN_PASSWORD=

# Email. Links in emails point at SITE_URL (wrangler.jsonc sets the deployed site).
# Without RESEND_API_KEY and EMAIL_FROM nothing is sent: emails are logged and /admin
# shows a preview. In production set both as secrets:
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put EMAIL_FROM        # e.g. AI in 5 <hello@your-domain>
# SITE_URL=http://localhost:5173/ai-news
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_POSTAL_ADDRESS=
# CONTACT_EMAIL=

# Bounce and complaint webhook from Resend (Webhooks → add endpoint
# <SITE_URL>/api/webhooks/resend, events email.bounced and email.complained). Paste its
# signing secret here for local tests; in production:
#   npx wrangler secret put RESEND_WEBHOOK_SECRET
# RESEND_WEBHOOK_SECRET=

# Owner alerts (failed runs, published issues, reader reports). Usually set in /admin;
# this is the fallback.
# ALERT_EMAIL=

# Turnstile on the subscribe form. wrangler.jsonc sets the production site key; locally
# leave both unset (no check), or use Cloudflare's always-pass test pair:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# In production the secret is a secret:
#   npx wrangler secret put TURNSTILE_SECRET_KEY

# Encrypts the Manyfold device code and agent tokens stored in D1.
# If unset, a random key is generated on first use and stored in the same database.
# Set this (>=32 chars) to keep the key out of the database:
#   npx wrangler secret put CONFIG_ENCRYPTION_KEY
# CONFIG_ENCRYPTION_KEY=
