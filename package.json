{
  "name": "manyfold-ai-news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI in 5: a daily AI news briefing, written by AI agents on Manyfold and checked against its sources, on the web and by email.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b && vite build && wrangler deploy --dry-run",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "jsonrepair": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "cloudflare": {
    "label": "AI in 5",
    "products": [
      "Workers",
      "D1"
    ],
    "bindings": {
      "DB": {
        "description": "Issues, pipeline runs, source copies, subscribers, readers' questions, and connected agents (tokens encrypted at rest)."
      }
    }
  }
}
