// Cloudflare Worker configuration.
//
// The "Deploy to Cloudflare" button reads this file: it provisions the D1 database
// declared below, writes the real database_id into your copy of the repo, and wires
// the repo to Workers Builds so every push to main redeploys automatically
// (build command: `npm run build`, deploy command: `npx wrangler deploy`).
//
// Keep `main`, `assets` and the `DB` binding valid — the app reads all three.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manyfold-ai-news",
  // NetMind.AI, the account that owns manyfold.ai. Pinned so a token for another account
  // fails instead of deploying a second copy there.
  "account_id": "9af64e6d33831f8a0718d0db1ad49c06",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  // Daily pipeline: 19:30 UTC, so the issue is ready before the first readers' 7:00, and
  // 20:30 UTC, which runs again only if the day's run failed (src/worker/pipeline/run.ts).
  // It only saves drafts; nothing is published without the owner (see /admin, Issues).
  // Every 15 minutes: email the published issue to subscribers whose local time is
  // 07:00 to 12:00 (src/worker/email/deliver.ts). Each cron runs as its own invocation.
  "triggers": {
    "crons": ["30 19 * * *", "30 20 * * *", "*/15 * * * *"]
  },
  "upload_source_maps": true,
  // The site is https://app.manyfold.ai/ai-news, next to the other Manyfold apps on that
  // host. Paths below it are handled in src/shared/base.ts. No workers.dev copy.
  "routes": [
    { "pattern": "app.manyfold.ai/ai-news", "zone_name": "manyfold.ai" },
    { "pattern": "app.manyfold.ai/ai-news/*", "zone_name": "manyfold.ai" }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ai-news/api/*"]
  },
  // Readers' own questions wait here for the answer agent: an agent turn can outlast what a
  // request may keep running after it responds. Create once: npx wrangler queues create aiin5-ask
  "queues": {
    "producers": [{ "binding": "ASK_QUEUE", "queue": "aiin5-ask" }],
    "consumers": [{ "queue": "aiin5-ask", "max_batch_size": 1, "max_retries": 2 }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manyfold-ai-news-db",
      "database_id": "7151c283-03a0-4ac5-a253-ca2a58a8e067"
    }
  ],
  "vars": {
    // Manyfold API base. Point at https://api-staging.manyfold.ai via .dev.vars for local dev.
    "MANYFOLD_API_BASE_URL": "https://api.manyfold.ai",
    // "production" enforces https-only and no-private-IP checks on agent URLs.
    "ENVIRONMENT": "production",
    // The public site, base path included (src/shared/base.ts). Links in emails point here.
    "SITE_URL": "https://app.manyfold.ai/ai-news"
  }
  // Optional hardening, neither is required to deploy:
  //   npx wrangler secret put ADMIN_PASSWORD          # locks the app behind a password
  //   npx wrangler secret put CONFIG_ENCRYPTION_KEY   # >=32 chars; otherwise a key is generated and stored in D1
  // Email (optional; without both, emails are logged in /admin but not sent):
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put EMAIL_FROM              # e.g. AI in 5 <hello@your-domain>
}
