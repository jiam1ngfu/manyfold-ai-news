// Cloudflare Worker configuration for AI in 5 (https://app.manyfold.ai/ai-news).
//
// Deploys are manual: `npm run build && npx wrangler deploy` from a checkout of main
// (see README "Deploying"). Pushing to GitHub does not deploy.
//
// Keep `main`, `assets` and the `DB` binding valid — the app reads all three.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manyfold-ai-news",
  // NetMind.AI, the account that owns manyfold.ai. Pinned so a token for another account
  // fails instead of deploying a second copy there.
  "account_id": "9af64e6d33831f8a0718d0db1ad49c06",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  // Daily pipeline: 19:30 UTC, so the issue is out before the first readers' 7:00 (Asia's
  // 7:00 is 23:00 UTC), and 20:30 UTC, which runs again only if the day's run failed and
  // then deletes data past its retention (src/worker/pipeline/run.ts, retention.ts). An
  // issue that passes the checks is published unless auto-publish is off in /admin.
  // Every 15 minutes: email the published issue to subscribers whose local time is
  // 07:00 to 12:00 (src/worker/email/deliver.ts). Each cron runs as its own invocation.
  "triggers": {
    "crons": ["30 19 * * *", "30 20 * * *", "*/15 * * * *"]
  },
  "upload_source_maps": true,
  // The site is https://app.manyfold.ai/ai-news, next to the other Manyfold apps on that
  // host. Paths below it are handled in src/shared/base.ts. No workers.dev copy.
  "routes": [
    { "pattern": "app.manyfold.ai/ai-news", "zone_name": "manyfold.ai" },
    { "pattern": "app.manyfold.ai/ai-news/*", "zone_name": "manyfold.ai" }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Pages go through the Worker so each one gets its own title, share card and status
    // (src/worker/pages.ts); built files and public/ai-news files are served directly.
    "run_worker_first": [
      "/ai-news",
      "/ai-news/*",
      "!/ai-news/assets/*",
      "!/ai-news/brand/*",
      "!/ai-news/og/*",
      "!/ai-news/favicon.svg",
      "!/ai-news/apple-touch-icon.png"
    ]
  },
  // Readers' own questions wait here for the answer agent: an agent turn can outlast what a
  // request may keep running after it responds. Create once: npx wrangler queues create aiin5-ask
  "queues": {
    "producers": [{ "binding": "ASK_QUEUE", "queue": "aiin5-ask" }],
    "consumers": [{ "queue": "aiin5-ask", "max_batch_size": 1, "max_retries": 2 }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manyfold-ai-news-db",
      "database_id": "7151c283-03a0-4ac5-a253-ca2a58a8e067"
    }
  ],
  "vars": {
    // Manyfold API base. Point at https://api-staging.manyfold.ai via .dev.vars for local dev.
    "MANYFOLD_API_BASE_URL": "https://api.manyfold.ai",
    // "production" enforces https-only and no-private-IP checks on agent URLs.
    "ENVIRONMENT": "production",
    // The public site, base path included (src/shared/base.ts). Links in emails, share
    // cards and the sitemap point here.
    "SITE_URL": "https://app.manyfold.ai/ai-news",
    // The publisher, in every email footer (CAN-SPAM) and on the privacy page. Same
    // entity and contact as Manyfold's own privacy policy (docs.manyfold.ai/privacy).
    "EMAIL_POSTAL_ADDRESS": "NetMind.AI Ltd, 6th Floor, 75 King William Street, London EC4N 7BE, United Kingdom",
    // Reply-To of every email (the sending domain takes no mail) and the privacy contact.
    "CONTACT_EMAIL": "customer-support@netmind.ai",
    // Turnstile on the subscribe form; public. Its secret is TURNSTILE_SECRET_KEY.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFVggIwuQiiBHXt5"
  }
  // Secrets (npx wrangler secret put NAME), none needed to deploy:
  //   ADMIN_PASSWORD          locks /admin and the admin API
  //   CONFIG_ENCRYPTION_KEY   >=32 chars; otherwise a key is generated and stored in D1
  //   RESEND_API_KEY          with EMAIL_FROM (e.g. AI in 5 <hello@your-domain>): without both,
  //   EMAIL_FROM              emails are logged in /admin but not sent
  //   RESEND_WEBHOOK_SECRET   signs bounce and complaint webhooks (whsec_…); off without it
  //   TURNSTILE_SECRET_KEY    with TURNSTILE_SITE_KEY above; the form has no check without it
}
